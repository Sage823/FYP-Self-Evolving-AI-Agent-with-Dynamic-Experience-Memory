# OpenAI-compatible chat-completions endpoint.
EXPERIENCE_LLM_BASE_URL=https://api.deepseek.com
EXPERIENCE_LLM_MODEL=deepseek-flash

# Prefer exporting this in the shell. Never commit the real value.
DEEPSEEK_API_KEY=replace-me

# Conservative per-run guard. The runner stops before crossing these limits.
EXPERIENCE_MAX_NEW_CALLS=120
EXPERIENCE_MAX_TOTAL_TOKENS=300000

